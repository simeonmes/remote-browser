# npm run setup generates a random secret in backend/.env. Never use this placeholder.
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PORT=4318
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_DOMAINS=example.com,www.example.com
HOME_URL=https://example.com/
AUTH_TTL_SECONDS=1800
LOG_LEVEL=info
BROWSER_CHANNEL=chromium
# The backend always binds to 127.0.0.1. Remote access is not enabled.
